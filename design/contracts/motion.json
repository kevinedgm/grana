{
  "$comment": "Tabla única de movimiento de Grana: lista canónica (dueño: lima; DECISIONS #1002 a #1009; tokens.md §29.9 y §29.10). Origen: design/lab/movimiento/r01/tabla.md, aprobada por el usuario el 2026-11-07 con D1 · A y D2 · A. Si este archivo y una tabla de los contratos difieren, manda este archivo. Lo lee packages/vue/scripts/check-motion.mjs (bruno): las reglas de `gate` se aplican tal cual, sin decidir nada. Un uso nuevo de una curva, un multiplicador nuevo o salirse de la fila de su tipo de pieza es una decisión con número.",
  "version": "0.1",
  "decisions": ["#1002", "#1003", "#1004", "#1005", "#1006", "#1007", "#1008", "#1009"],

  "durations": {
    "fast": "--g-duration-fast",
    "press": "--g-duration-press",
    "slow": "--g-duration-slow",
    "spin": "--g-duration-spin"
  },
  "curves": {
    "standard": "--g-ease-standard",
    "out": "--g-ease-out",
    "spring": "--g-ease-spring",
    "bounce": "--g-ease-bounce",
    "linear": "linear"
  },
  "transitionCap": {
    "token": "slow",
    "appliesTo": "toda transición de la interfaz (§29.10)",
    "notTransitions": ["señal de llegada", "carga", "tiempo de lectura", "ilustración"]
  },

  "pieces": {
    "panelAnclado": {
      "label": "Panel anclado",
      "enter": { "duration": "press", "curve": "out", "fade": true, "offset": "space × 1", "from": "lado del disparador", "scale": false },
      "exit": { "duration": "fast", "curve": "out", "fade": true, "offset": null, "scale": false, "requires": "overlay" },
      "reduced": { "enter": { "duration": "fast", "curve": "linear", "fade": true, "offset": null, "scale": false }, "exit": { "duration": "fast", "curve": "linear", "fade": true, "offset": null, "scale": false, "requires": "overlay" } }
    },
    "hojaMovil": {
      "label": "Hoja móvil (≤ 520 px)",
      "enter": { "duration": "press", "curve": "out", "fade": true, "offset": "space × 6", "from": "su borde", "scale": false, "backdrop": { "duration": "press", "fade": true } },
      "exit": { "duration": "fast", "curve": "out", "fade": true, "offset": null, "scale": false, "backdrop": { "duration": "fast", "fade": true }, "requires": "overlay" },
      "reduced": { "enter": { "duration": "fast", "curve": "linear", "fade": true, "offset": null, "scale": false }, "exit": { "duration": "fast", "curve": "linear", "fade": true, "offset": null, "scale": false, "requires": "overlay" } }
    },
    "dialogo": {
      "label": "Diálogo",
      "enter": { "duration": "press", "curve": "out", "fade": true, "offset": "D1 de #301", "from": "disparador", "scale": "--g-press-scale" },
      "exit": { "duration": "fast", "curve": "out", "fade": true, "offset": "D1 de #301", "to": "su origen", "scale": "--g-press-scale", "requires": "overlay" },
      "reduced": { "enter": { "duration": "fast", "curve": "linear", "fade": true, "offset": null, "scale": false }, "exit": { "duration": "fast", "curve": "linear", "fade": true, "offset": null, "scale": false, "requires": "overlay" } }
    },
    "plegado": {
      "label": "Plegado",
      "enter": { "duration": "slow", "curve": "out", "property": "altura" },
      "exit": { "duration": "slow", "curve": "out", "property": "altura", "content": { "duration": "fast", "fade": true } },
      "reduced": { "enter": { "duration": null, "property": "sin transición de altura" }, "exit": { "duration": null, "property": "sin transición de altura" } },
      "note": "Un plegado cambia de tamaño: no entra ni sale de la página. #152 («la salida es más corta») se cumple en el contenido, no en la altura (#1007)."
    },
    "avisoFlotante": {
      "label": "Aviso flotante",
      "enter": { "duration": "press", "curve": "out", "fade": true, "contract": "GStatusIsland: la caída de status.md (slow + ease-out, #701)" },
      "exit": { "duration": "fast", "fade": true, "contract": "GStatusIsland: la subida de status.md" },
      "reduced": { "enter": { "duration": "fast", "fade": true, "offset": null }, "exit": { "duration": "fast", "fade": true, "offset": null } }
    }
  },

  "moments": {
    "hover": {
      "label": "Hover de un control",
      "where": "Botones, campos, enlaces",
      "rule": { "properties": ["color", "borde"], "duration": "fast", "curve": "standard", "scale": false, "media": "(hover: hover)" },
      "reduced": "igual: es color"
    },
    "pulsar": {
      "label": "Pulsar",
      "where": "GBtn y lo que lo compone",
      "rule": { "press": { "duration": "fast", "curve": "out", "to": "--g-press-scale" }, "release": { "duration": "slow", "curve": "bounce" }, "held": "con carga se queda apretado y suelta a la llegada (retén, GBtn, #1013)" },
      "reduced": "sin escala"
    },
    "foco": {
      "label": "Foco",
      "where": "Todo",
      "rule": "Nunca se anima: el anillo aparece en el acto",
      "reduced": "igual",
      "status": "abierta",
      "enforced": false,
      "conflict": "Choca con #35 (anillo de GInput «con transición de color», comentario del usuario) y con el «anillo que se abre» de design/lab/checkbox/estilo.md y design/lab/switch/estilo.md. Decide el usuario (#1008). Hasta entonces, ni compuerta ni cambio en el CSS.",
      "code": ["GCheckbox.css", "GDatePicker.css", "GFileField.css", "GInput.css", "GInputGroup.css", "GPartyField.css", "GRadioGroup.css", "GSelect.css", "GSwitch.css", "GTextarea.css", "GTranscript.css"]
    },
    "recorrerFilas": {
      "label": "Recorrer una lista con filas que se tocan",
      "where": ["GMenu", "GSidebar", "GTable", "GSelect"],
      "rule": { "model": "una sola luz (api.md)", "travel": { "duration": "press", "curve": "out" }, "firstPlacement": "aparece sin viajar", "appear": { "duration": "fast", "fade": true } },
      "reduced": "solo fundido, sin viaje"
    },
    "recorrerHuecos": {
      "label": "Recorrer una lista con huecos o una rejilla",
      "where": ["GCombobox (fichas)", "GDatePicker (días)", "GSidebar (navbar)"],
      "rule": { "model": "una marca por elemento (api.md «Una sola luz», regla 9)", "maxLit": 1, "exit": "instantánea" },
      "reduced": "igual"
    },
    "marcar": {
      "label": "Marcar o elegir",
      "where": "Casillas, radios, interruptores, opción elegida",
      "rule": { "properties": ["color", "relleno", "marca que aparece"], "duration": "fast" },
      "reduced": "sin escala",
      "exceptions": ["marca-que-se-traza"]
    },
    "carga": {
      "label": "Carga",
      "where": "Todo giro",
      "rule": { "duration": "spin", "curve": "linear", "times": "200/400/5000 ms de utils/loadPhase.js donde aplique" },
      "reduced": "giro lento: calc(var(--g-duration-spin) * 2.5)"
    },
    "senalLlegada": {
      "label": "Señal de llegada",
      "where": ["data-g-landed", "is-here de GTable", "g-btn__done"],
      "rule": { "max": "slow × 4", "decorative": true, "blocks": false, "isTransition": false },
      "reduced": "fundido corto",
      "decisions": ["#589", "#594", "#1003", "#1012"]
    }
  },

  "lightOwners": [
    { "case": "foco dentro de la lista", "components": ["GMenu"], "follows": "el foco", "pointerMovesFocus": true, "ring": "el del foco" },
    { "case": "foco fuera de la lista, con opción activa", "components": ["GSelect"], "follows": "la opción activa, por puntero o teclado", "pointerMovesFocus": false, "ring": "solo tras usar el teclado" },
    { "case": "lista en la secuencia de Tab", "components": ["GSidebar", "GTable"], "follows": "el puntero", "pointerMovesFocus": false, "ring": "solo con teclado" }
  ],

