{
  "name": "@grana/site",
  "version": "0.1.0-beta.0",
  "private": true,
  "description": "Sitio de documentación de Grana (VitePress), generado desde los README y los meta.json de los componentes.",
  "type": "module",
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "docs:dev": "node scripts/generate.mjs && vitepress dev .",
    "docs:build": "node scripts/generate.mjs && vitepress build .",
    "docs:preview": "vitepress preview .",
    "test": "node --test scripts/generate.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@grana/blocks": "*",
    "@grana/cli": "*",
    "@grana/vue": "*",
    "@vueuse/core": "^12.4.0",
    "lucide-static": "^1.70.0",
    "minisearch": "^7.1.1",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "vitepress": "1.6.4"
  }
}
