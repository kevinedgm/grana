{
  "name": "grana-monorepo",
  "version": "0.1.0-beta.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "site"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "docs:dev": "npm run docs:dev -w @grana/site",
    "docs:build": "npm run docs:build -w @grana/site",
    "docs:preview": "npm run docs:preview -w @grana/site"
  },
  "overrides": {
    "vitepress": {
      "vite": "^6.4.3"
    }
  }
}
