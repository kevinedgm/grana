{
  "schemaVersion": 1,
  "name": "GSurface",
  "tag": "g-surface",
  "status": "candidate",
  "since": "0.1.0",
  "description": "Superficie visual genérica, sin rol ni estructura: niveles flat, outlined, raised, floating e inset; la inset da un paso de tono respecto a su superficie padre y toma su radio concéntrico. Con zone=\"brand\" abre una zona de marca: la superficie se pinta con la marca y sus descendientes reciben el grupo de color de la zona.",
  "contract": "design/contracts/surface.md",
  "prototype": "design/lab/surface/r01/",
  "style": "packages/vue/src/components/GSurface/GSurface.css",
  "props": [
    {
      "name": "level",
      "type": "String",
      "default": "outlined",
      "values": [
        "flat",
        "outlined",
        "raised",
        "floating",
        "inset"
      ]
    },
    {
      "name": "tone",
      "type": "String",
      "default": "surface",
      "values": [
        "surface",
        "sunken"
      ]
    },
    {
      "name": "padding",
      "type": "String",
      "default": "md",
      "values": [
        "none",
        "xs",
        "sm",
        "md",
        "lg"
      ]
    },
    {
      "name": "rounded",
      "type": "String",
      "default": null,
      "values": [
        "none",
        "xs",
        "sm",
        "md",
        "lg",
        "xl",
        "pill"
      ]
    },
    {
      "name": "density",
      "type": "String",
      "default": null,
      "values": [
        "default",
        "comfortable",
        "compact"
      ],
      "resolvedDefault": "default",
      "note": "Sin valor: la región más cercana (data-g-density) › <html data-g-density> › clave density del tema › default (density.md §1)"
    },
    {
      "name": "as",
      "type": "String",
      "default": "div"
    },
    {
      "name": "zone",
      "type": "String",
      "default": "none",
      "values": [
        "none",
        "brand"
      ]
    }
  ],
  "events": [],
  "slots": [
    {
      "name": "default",
      "purpose": "Contenido libre"
    }
  ],
  "classes": {
    "root": "g-surface g-surface--level-{flat|outlined|raised|floating|inset} g-surface--tone-{surface|sunken} g-surface--padding-{none|xs|sm|md|lg} g-surface--density-{default|comfortable|compact} g-surface--rounded-{…}",
    "state": [
      "g-surface--zone-brand (con zone=\"brand\"; tone se emite como surface)"
