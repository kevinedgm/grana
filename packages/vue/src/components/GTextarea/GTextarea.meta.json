{
  "schemaVersion": 1,
  "name": "GTextarea",
  "tag": "g-textarea",
  "status": "candidate",
  "since": "0.1.0",
  "description": "Campo de texto de varias líneas con etiqueta, ayuda, error, contador con aviso hablado discreto, filas fijas o autosize.",
  "contract": "design/contracts/textarea.md",
  "prototype": "design/lab/textarea/r01/",
  "style": "packages/vue/src/components/GTextarea/GTextarea.css",
  "props": [
    {
      "name": "modelValue",
      "type": "String",
      "default": ""
    },
    {
      "name": "variant",
      "type": "String",
      "default": "outline",
      "values": [
        "outline",
        "soft"
      ]
    },
    {
      "name": "size",
      "type": "String",
      "default": "md",
      "values": [
        "xs",
        "sm",
        "md",
        "lg",
        "xl"
      ]
    },
    {
      "name": "density",
      "type": "String",
      "default": null,
      "values": [
        "default",
        "comfortable",
        "compact"
      ],
      "resolvedDefault": "default",
      "note": "Sin valor: prop explícita › contexto de GForm › default de siempre (form.md §2)"
    },
    {
      "name": "color",
      "type": "String",
      "default": null,
      "values": [
        "brand",
        "accent",
        "neutral",
        "success",
        "warning",
        "danger",
        "info"
      ]
    },
    {
      "name": "rounded",
      "type": "String",
      "default": null,
      "values": [
        "none",
        "xs",
        "sm",
        "md",
        "lg",
        "xl",
        "pill"
      ]
    },
    {
      "name": "block",
      "type": "Boolean",
      "default": null,
      "resolvedDefault": false,
      "note": "Sin valor: prop explícita › contexto de GForm › default de siempre (form.md §2)"
    },
    {
      "name": "disabled",
      "type": "Boolean",
      "default": null,
      "resolvedDefault": false,
      "note": "Sin valor: prop explícita › contexto de GForm › default de siempre (form.md §2)"
    },
    {
      "name": "readonly",
      "type": "Boolean",
      "default": null,
      "resolvedDefault": false,
      "note": "Sin valor: prop explícita › contexto de GForm › default de siempre (form.md §2)"
    },
    {
      "name": "loading",
      "type": "Boolean",
      "default": false
    },
    {
      "name": "rows",
      "type": "Number",
      "default": 3
    },
    {
      "name": "autosize",
      "type": "Boolean",
      "default": false
    },
    {
      "name": "maxRows",
      "type": "Number",
      "default": null
    },
    {
      "name": "resize",
      "type": "String",
      "default": "vertical",
      "values": [
        "none",
        "vertical"
      ]
    },
    {
      "name": "label",
      "type": "String",
      "default": null
    },
    {
      "name": "hint",
      "type": "String",
      "default": null
    },
    {
      "name": "error",
      "type": "String",
      "default": null
    },
    {
      "name": "warning",
      "type": "String",
      "default": null,
      "note": "Advertencia: no bloquea ni pone aria-invalid (C5)"
    },
    {
      "name": "valid",
      "type": "String",
      "default": null,
      "note": "Mensaje de válido útil (C5)"
    },
    {
      "name": "required",
      "type": "Boolean",
      "default": false
    },
    {
      "name": "mark",
      "type": "Boolean",
      "default": null,
      "note": "false quita la marca de la convención de GForm (C3)"
    },
    {
      "name": "counter",
      "type": "Boolean",
      "default": false
    },
    {
      "name": "counterText",
      "type": "Function",
      "default": null
    },
    {
      "name": "id",
      "type": "String",
      "default": null
    }
  ],
  "events": [
    {
      "name": "update:modelValue",
      "payload": "String",
      "trigger": "El usuario cambia el valor (evento input nativo)"
    }
  ],
  "slots": [
    {
      "name": "label",
      "purpose": "Etiqueta con contenido rico (sustituye a label)"
    },
    {
      "name": "hint",
      "purpose": "Ayuda con contenido rico (sustituye a hint)"
    },
    {
      "name": "error",
      "purpose": "Mensaje de error con contenido rico; solo se muestra con error (en la región __message)"
    }
  ],
  "tokens": [
    "--g-color-surface",
    "--g-color-surface-sunken",
    "--g-color-border-control",
    "--g-color-border-strong",
    "--g-color-text",
    "--g-color-text-muted",
    "--g-color-text-subtle",
    "--g-color-danger-text",
    "--g-color-focus",
    "--g-color-{color}-text",
    "--g-radius-{rounded}",
    "--g-radius-sm",
    "--g-radius-lg",
    "--g-space-1",
    "--g-space-2..5",
    "--g-font-ui",
    "--g-text-{caption|body-sm|body}-{size|line}",
    "--g-text-action-weight",
    "--g-border-width",
    "--g-focus-width",
    "--g-duration-fast",
    "--g-duration-slow",
    "--g-duration-spin",
    "--g-ease-standard"
  ],
  "states": [
    "default",
    "hover",
    "focus-visible",
    "disabled",
    "readonly",
    "invalid",
    "loading",
    "autosize",
    "capped",
    "warning",
    "valid"
  ],
  "classes": {
    "personality": [
      "is-ready en la raíz: dos cuadros después de montar (tras el primer pintado), nunca en SSR; sin ella no se anima la entrada del mensaje (I1, #304 y #306; el CSS de I1 es de coco)",
      "is-rejected en la raíz: la pone GForm tras un envío con errores o showErrors() si este campo bloquea (I2, #304)"
    ]
  },
  "pending": [
    "Lector de pantalla real: etiqueta, ayuda, error y aviso del contador",
    "Rendimiento de autosize con textos de miles de líneas",
    "Firefox y Safari (tirador, :has())"
  ],
  "formSystem": {
    "contract": "design/contracts/form.md §10",
    "changes": [
      "C1 contexto con useFormField",
      "C3 marcas",
      "C4 región __message",
      "C5 warning/valid",
      "C6 iconos",
      "C8 manejadores primero",
      "C10 registro"
    ]
  }
}
