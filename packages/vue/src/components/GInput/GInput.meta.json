{
  "schemaVersion": 1,
  "name": "GInput",
  "tag": "g-input",
  "status": "candidate",
  "since": "0.1.0",
  "description": "Campo de texto de una línea con etiqueta, ayuda, error, iconos y contador.",
  "contract": "design/contracts/input.md",
  "prototype": "design/lab/input/r01/",
  "style": "packages/vue/src/components/GInput/GInput.css",
  "props": [
    { "name": "modelValue", "type": "String", "default": "" },
    { "name": "variant", "type": "String", "default": "outline", "values": ["outline", "soft"] },
    { "name": "size", "type": "String", "default": "md", "values": ["xs", "sm", "md", "lg", "xl"] },
    { "name": "density", "type": "String", "default": null, "values": ["default", "comfortable", "compact"], "resolvedDefault": "default", "note": "Sin valor: prop explícita › contexto de GForm › default de siempre (form.md §2)" },
    { "name": "color", "type": "String", "default": null, "values": ["brand", "accent", "neutral", "success", "warning", "danger", "info"] },
    { "name": "rounded", "type": "String", "default": null, "values": ["none", "xs", "sm", "md", "lg", "xl", "pill"] },
    { "name": "block", "type": "Boolean", "default": null, "resolvedDefault": false, "note": "Sin valor: prop explícita › contexto de GForm › default de siempre (form.md §2)" },
    { "name": "disabled", "type": "Boolean", "default": null, "resolvedDefault": false, "note": "Sin valor: prop explícita › contexto de GForm › default de siempre (form.md §2)" },
    { "name": "readonly", "type": "Boolean", "default": null, "resolvedDefault": false, "note": "Sin valor: prop explícita › contexto de GForm › default de siempre (form.md §2)" },
    { "name": "loading", "type": "Boolean", "default": false },
    { "name": "type", "type": "String", "default": "text", "values": ["text", "email", "password", "search", "tel", "url"] },
    { "name": "label", "type": "String", "default": null },
    { "name": "hint", "type": "String", "default": null },
    { "name": "error", "type": "String", "default": null },
    { "name": "warning", "type": "String", "default": null, "note": "Advertencia: no bloquea ni pone aria-invalid (C5)" },
    { "name": "valid", "type": "String", "default": null, "note": "Mensaje de válido útil (C5)" },
    { "name": "required", "type": "Boolean", "default": false },
    { "name": "mark", "type": "Boolean", "default": null, "note": "false quita la marca de la convención de GForm (C3)" },
    { "name": "prefix", "type": "String", "default": null, "note": "Texto visible antes del valor ($) (C13)" },
    { "name": "suffix", "type": "String", "default": null, "note": "Texto visible después del valor (kg, %) (C13)" },
    { "name": "prefixLabel", "type": "String", "default": null, "note": "Expansión accesible del prefijo" },
    { "name": "suffixLabel", "type": "String", "default": null, "note": "Expansión accesible del sufijo (kilogramos)" },
    { "name": "output", "type": "String", "default": null, "note": "Valor calculado por la aplicación (C14, #180): <output> al final de la caja, tras el sufijo; siempre presente con la prop; en aria-describedby solo con texto; no se envía" },
    { "name": "counter", "type": "Boolean", "default": false },
    { "name": "showPasswordLabel", "type": "String", "default": null },
    { "name": "hidePasswordLabel", "type": "String", "default": null },
    { "name": "id", "type": "String", "default": null }
  ],
  "events": [
    { "name": "update:modelValue", "payload": "String", "trigger": "El usuario cambia el valor" }
  ],
  "slots": [
    { "name": "label", "purpose": "Etiqueta con contenido rico (sustituye a label)" },
    { "name": "prepend", "purpose": "Icono decorativo antes del texto" },
    { "name": "append", "purpose": "Icono decorativo después del texto" },
    { "name": "hint", "purpose": "Ayuda con contenido rico (sustituye a hint)" },
    { "name": "error", "purpose": "Mensaje de error con contenido rico; solo se muestra con error (en la región __message)" },
    { "name": "action", "purpose": "Botón de acción acoplado al final de la caja. Slot con alcance: { size, density, disabled }; el consumidor pone un GBtn" }
  ],
  "tokens": ["--g-color-surface", "--g-color-surface-sunken", "--g-color-border-control", "--g-color-border-strong", "--g-color-text", "--g-color-text-muted", "--g-color-text-subtle", "--g-color-danger-text", "--g-color-focus", "--g-color-{color}-text", "--g-radius-*", "--g-space-1..6", "--g-font-ui", "--g-text-{caption|body-sm|body}-{size|line}", "--g-text-action-weight", "--g-border-width", "--g-focus-width", "--g-focus-offset", "--g-duration-fast", "--g-duration-spin", "--g-ease-standard"],
  "states": ["default", "hover", "focus-visible", "filled", "disabled", "readonly", "invalid", "loading", "warning", "valid"],
  "pending": ["Lector de pantalla real: aria-live junto a aria-describedby y anuncio del conjunto con acción", "Ancho del botón mostrar/ocultar con textos largos"],
  "formSystem": {"contract": "design/contracts/form.md §10", "changes": ["C1 contexto con useFormField", "C3 marcas", "C4 región __message", "C5 warning/valid", "C6 iconos", "C8 manejadores primero", "C10 registro", "C13 prefix/suffix"]}
}
