{
  "schemaVersion": 1,
  "name": "GCheckboxGroup",
  "tag": "g-checkbox-group",
  "status": "candidate",
  "since": "0.1.0",
  "description": "Grupo de casillas con modelo de arreglo, casilla maestra derivada de las hijas y conteo en región viva.",
  "contract": "design/contracts/checkbox.md",
  "prototype": "design/lab/checkbox/r01/",
  "style": "packages/vue/src/components/GCheckboxGroup/GCheckboxGroup.css",
  "props": [
    {
      "name": "modelValue",
      "type": "Array",
      "default": []
    },
    {
      "name": "label",
      "type": "String",
      "default": null
    },
    {
      "name": "hint",
      "type": "String",
      "default": null
    },
    {
      "name": "error",
      "type": "String",
      "default": null
    },
    {
      "name": "warning",
      "type": "String",
      "default": null,
      "note": "Advertencia: no bloquea ni pone aria-invalid (C5)"
    },
    {
      "name": "valid",
      "type": "String",
      "default": null,
      "note": "Mensaje de válido útil (C5)"
    },
    {
      "name": "required",
      "type": "Boolean",
      "default": false,
      "note": "Marca de la pregunta en el legend (C3)"
    },
    {
      "name": "mark",
      "type": "Boolean",
      "default": null,
      "note": "false quita la marca de la convención de GForm (C3)"
    },
    {
      "name": "name",
      "type": "String",
      "default": null,
      "note": "Clave del grupo en errors y name por defecto de sus casillas (C11)"
    },
    {
      "name": "selectAll",
      "type": "Boolean",
      "default": false
    },
    {
      "name": "selectAllLabel",
      "type": "String",
      "default": null
    },
    {
      "name": "countText",
      "type": "Function",
      "default": null
    },
    {
      "name": "size",
      "type": "String",
      "default": "md",
      "values": [
        "xs",
        "sm",
        "md",
        "lg",
        "xl"
      ]
    },
    {
      "name": "density",
      "type": "String",
      "default": null,
      "values": [
        "default",
        "comfortable",
        "compact"
      ],
      "resolvedDefault": "default",
      "note": "Sin valor: prop explícita › contexto de GForm › default de siempre (form.md §2)"
    },
    {
      "name": "color",
      "type": "String",
      "default": "brand",
      "values": [
        "brand",
        "accent",
        "neutral",
        "success",
        "warning",
        "danger",
        "info"
      ]
    },
    {
      "name": "layout",
      "type": "String",
      "default": "default",
      "values": [
        "default",
        "card",
        "chip"
      ]
    },
    {
      "name": "disabled",
      "type": "Boolean",
      "default": null,
      "resolvedDefault": false,
      "note": "Sin valor: prop explícita › contexto de GForm › default de siempre (form.md §2)"
    },
    {
      "name": "id",
      "type": "String",
      "default": null
    }
  ],
  "events": [
    {
      "name": "update:modelValue",
      "payload": "Array",
      "trigger": "El usuario alterna una hija o la maestra"
    }
  ],
  "slots": [
    {
      "name": "default",
      "purpose": "Las casillas hijas (GCheckbox con value)"
    },
    {
      "name": "label",
      "purpose": "Título del grupo con contenido rico (sustituye a label)"
    },
    {
      "name": "hint",
      "purpose": "Ayuda del grupo con contenido rico"
    },
    {
      "name": "error",
      "purpose": "Mensaje de error con contenido rico; solo se muestra con error (en la región __message)"
    }
  ],
  "tokens": [
    "--g-color-border",
    "--g-color-text",
    "--g-color-text-muted",
    "--g-color-text-subtle",
    "--g-color-danger-text",
    "--g-space-1..4",
    "--g-font-ui",
    "--g-text-{caption|body-sm}-{size|line}",
    "--g-text-action-weight",
    "--g-border-width"
  ],
  "states": [
    "default",
    "disabled",
    "error",
    "warning",
    "valid"
  ],
  "pending": [
    "Lector de pantalla real: conteo y estado mixto de la maestra"
  ],
  "formSystem": {
    "contract": "design/contracts/form.md §10",
    "changes": [
      "C1 contexto con useFormField",
      "C3 marcas",
      "C4 región __message",
      "C5 warning/valid",
      "C6 iconos",
      "C8 manejadores primero",
      "C10 registro"
    ]
  }
