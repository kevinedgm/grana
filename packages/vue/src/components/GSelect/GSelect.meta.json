{
  "schemaVersion": 1,
  "name": "GSelect",
  "tag": "g-select",
  "status": "candidate",
  "since": "0.1.0",
  "description": "Selector de una opción con lista propia (combobox de solo selección): grupos, opciones deshabilitadas, teclado completo con typeahead, hoja inferior en móvil.",
  "contract": "design/contracts/select.md",
  "prototype": "design/lab/select/r01/",
  "style": "packages/vue/src/components/GSelect/GSelect.css",
  "props": [
    {
      "name": "modelValue",
      "type": "String | Number | null",
      "default": null
    },
    {
      "name": "options",
      "type": "Array",
      "default": []
    },
    {
      "name": "variant",
      "type": "String",
      "default": "outline",
      "values": [
        "outline",
        "soft"
      ]
    },
    {
      "name": "size",
      "type": "String",
      "default": "md",
      "values": [
        "xs",
        "sm",
        "md",
        "lg",
        "xl"
      ]
    },
    {
      "name": "density",
      "type": "String",
      "default": null,
      "values": [
        "default",
        "comfortable",
        "compact"
      ],
      "resolvedDefault": "default",
      "note": "Sin valor: prop explícita › contexto de GForm › default de siempre (form.md §2)"
    },
    {
      "name": "color",
      "type": "String",
      "default": null,
      "values": [
        "brand",
        "accent",
        "neutral",
        "success",
        "warning",
        "danger",
        "info"
      ]
    },
    {
      "name": "rounded",
      "type": "String",
      "default": null,
      "values": [
        "none",
        "xs",
        "sm",
        "md",
        "lg",
        "xl",
        "pill"
      ]
    },
    {
      "name": "block",
      "type": "Boolean",
      "default": null,
      "resolvedDefault": false,
      "note": "Sin valor: prop explícita › contexto de GForm › default de siempre (form.md §2)"
    },
    {
      "name": "disabled",
      "type": "Boolean",
      "default": null,
      "resolvedDefault": false,
      "note": "Sin valor: prop explícita › contexto de GForm › default de siempre (form.md §2)"
    },
    {
      "name": "readonly",
      "type": "Boolean",
      "default": null,
      "resolvedDefault": false,
      "note": "Sin valor: prop explícita › contexto de GForm › default de siempre (form.md §2)"
    },
    {
      "name": "loading",
      "type": "Boolean",
      "default": false
    },
    {
      "name": "placeholder",
      "type": "String",
      "default": null
    },
    {
      "name": "clearable",
      "type": "Boolean",
      "default": false
    },
    {
      "name": "clearLabel",
      "type": "String",
      "default": null
    },
    {
      "name": "emptyText",
      "type": "String",
      "default": null
    },
    {
      "name": "createLabel",
      "type": "String",
      "default": null
    },
    {
      "name": "label",
      "type": "String",
      "default": null
    },
    {
      "name": "hint",
      "type": "String",
      "default": null
    },
    {
      "name": "error",
      "type": "String",
      "default": null
    },
    {
      "name": "warning",
      "type": "String",
      "default": null,
      "note": "Advertencia: no bloquea ni pone aria-invalid (C5)"
    },
    {
      "name": "valid",
      "type": "String",
      "default": null,
      "note": "Mensaje de válido útil (C5)"
    },
    {
      "name": "required",
      "type": "Boolean",
      "default": false
    },
    {
      "name": "mark",
      "type": "Boolean",
      "default": null,
      "note": "false quita la marca de la convención de GForm (C3)"
    },
    {
      "name": "name",
      "type": "String",
      "default": null
    },
    {
      "name": "id",
      "type": "String",
      "default": null
    }
  ],
  "events": [
    {
      "name": "update:modelValue",
      "payload": "String | Number | null",
      "trigger": "El usuario elige una opción distinta o borra con clearable (null)"
    },
    {
      "name": "open",
      "payload": "",
      "trigger": "La lista se abre"
    },
    {
      "name": "close",
      "payload": "",
      "trigger": "La lista se cierra, por el motivo que sea"
    },
    {
      "name": "create",
      "payload": "",
      "trigger": "El usuario activa la fila «Agregar nuevo…» (createLabel). No cambia el valor; el foco ya volvió al selector"
    }
  ],
  "slots": [
    {
      "name": "label",
      "purpose": "Etiqueta con contenido rico (sustituye a label)"
    },
    {
      "name": "hint",
      "purpose": "Ayuda con contenido rico"
    },
    {
      "name": "error",
      "purpose": "Mensaje de error con contenido rico; solo se muestra con error (en la región __message)"
    },
    {
      "name": "option",
      "purpose": "Contenido de una opción. Alcance: { option, selected, active }. Sin interactivos"
    },
    {
      "name": "value",
      "purpose": "Contenido del valor mostrado. Alcance: { option }. Solo con una opción elegida"
    },
    {
      "name": "empty",
      "purpose": "Contenido de la lista vacía (sustituye a emptyText)"
    },
    {
      "name": "prepend",
      "purpose": "Icono decorativo antes del valor, dentro del botón (aria-hidden). Lo sustituye el icono de la opción elegida"
    },
    {
      "name": "icon",
      "purpose": "Icono decorativo de una opción y del valor mostrado. Alcance: { option }. Solo se pinta si devuelve contenido; no se usa si se usan los slots option o value"
    }
  ],
  "tokens": [
    "--g-color-surface",
    "--g-color-surface-sunken",
    "--g-color-border-control",
    "--g-color-text",
    "--g-color-text-muted",
    "--g-color-text-subtle",
    "--g-color-danger-text",
    "--g-color-focus",
    "--g-color-{color}-text",
    "--g-radius-{rounded}",
    "--g-radius-sm",
    "--g-radius-md",
    "--g-radius-pill",
    "--g-space-1..6",
    "--g-font-ui",
    "--g-text-{caption|body-sm|body}-{size|line}",
    "--g-text-action-weight",
    "--g-border-width",
    "--g-focus-width",
    "--g-shadow-2",
    "--g-shadow-3",
    "--g-surface-inset",
    "--g-surface-gap",
    "--g-surface-radius",
    "--g-surface-backdrop",
    "--g-duration-fast",
    "--g-duration-press",
    "--g-duration-spin",
    "--g-ease-standard",
    "--g-ease-out"
  ],
  "states": [
    "closed",
    "open",
    "hover",
    "focus-visible",
    "disabled",
    "readonly",
    "invalid",
    "loading",
    "option-active",
    "option-selected",
    "option-disabled",
    "list-up",
    "sheet",
    "create-row",
    "with-prefix",
    "with-icons",
    "warning",
    "valid"
  ],
  "pending": [
    "Lector de pantalla real (incluido aria-activedescendant en la hoja móvil)",
    "Hoja inferior con teclado virtual y táctil reales",
    "Firefox y Safari (popover, ::backdrop, :popover-open, :has())",
    "Selección múltiple, búsqueda y virtualización (v0.2)"
  ],
  "formSystem": {
    "contract": "design/contracts/form.md §10",
    "changes": [
      "C1 contexto con useFormField",
      "C3 marcas",
      "C4 región __message",
      "C5 warning/valid",
      "C6 iconos",
      "C8 manejadores primero",
      "C10 registro"
    ]
  }
}
