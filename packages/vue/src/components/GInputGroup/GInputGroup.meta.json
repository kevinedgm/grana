{
  "schemaVersion": 1,
  "name": "GInputGroup",
  "tag": "g-input-group",
  "status": "draft",
  "since": "0.1.0",
  "description": "Campo fusionado: un dato en varias partes que se lee como uno (teléfono país + número, valor + unidad, moneda + importe, serie + folio, rango). Una caja, una etiqueta, un mensaje; cada parte con foco y nombre propios.",
  "contract": "design/contracts/form.md",
  "prototype": "design/lab/form/r02/",
  "style": "packages/vue/src/components/GInputGroup/GInputGroup.css",
  "props": [
    {
      "name": "label",
      "type": "String",
      "default": null
    },
    {
      "name": "hint",
      "type": "String",
      "default": null
    },
    {
      "name": "name",
      "type": "String",
      "default": null,
      "note": "Clave del grupo en errors/warnings (las partes tienen la suya)"
    },
    {
      "name": "error",
      "type": "String",
      "default": null
    },
    {
      "name": "warning",
      "type": "String",
      "default": null
    },
    {
      "name": "valid",
      "type": "String",
      "default": null
    },
    {
      "name": "required",
      "type": "Boolean",
      "default": false,
      "note": "Marca de la etiqueta y required por defecto de cada parte"
    },
    {
      "name": "mark",
      "type": "Boolean",
      "default": null
    },
    {
      "name": "readonly",
      "type": "Boolean",
      "default": null,
      "note": "Sin valor: hereda del contexto"
    },
    {
      "name": "disabled",
      "type": "Boolean",
      "default": null,
      "note": "Sin valor: hereda del contexto"
    },
    {
      "name": "size",
      "type": "String",
      "default": "md",
      "values": [
        "xs",
        "sm",
        "md",
        "lg",
        "xl"
      ]
    },
    {
      "name": "variant",
      "type": "String",
      "default": "outline",
      "values": [
        "outline",
        "soft"
      ]
    },
    {
      "name": "density",
      "type": "String",
      "default": null,
      "values": [
        "default",
        "comfortable",
        "compact"
      ]
    },
    {
      "name": "block",
      "type": "Boolean",
      "default": null,
      "note": "Dentro de GFormLayout/GFormRow, true"
    },
    {
      "name": "id",
      "type": "String",
      "default": null
    }
  ],
  "events": [],
  "slots": [
    {
      "name": "label",
      "purpose": "Etiqueta rica"
    },
    {
      "name": "hint",
      "purpose": "Ayuda rica"
    },
    {
      "name": "default",
      "purpose": "Partes: GInputGroupInput, GInputGroupSelect, GInputGroupText"
    }
  ],
  "parts": {
    "GInputGroupInput": {
      "props": [
        {
          "name": "modelValue",
          "type": "String",
          "default": ""
        },
        {
          "name": "name",
          "type": "String",
          "default": null
        },
        {
          "name": "partLabel",
          "type": "String",
          "default": null
        },
        {
          "name": "principal",
          "type": "Boolean",
          "default": false
        },
        {
          "name": "required",
          "type": "Boolean",
          "default": null,
          "note": "Sin valor: el del grupo"
        },
        {
          "name": "error",
          "type": "String",
          "default": null
        },
        {
          "name": "type",
          "type": "String",
          "default": "text",
          "values": [
            "text",
            "tel",
            "email",
            "url",
            "search"
          ]
        },
        {
          "name": "chars",
          "type": "Number",
          "default": null,
          "note": "Ancho fijo en caracteres (--_input-group-chars)"
        },
        {
          "name": "id",
          "type": "String",
          "default": null
        }
      ],
      "events": [
        {
          "name": "update:modelValue",
          "payload": "String",
          "trigger": "input"
        }
      ],
      "attrs": "autocomplete, inputmode, placeholder, maxlength, pattern y escuchas al <input>; class y style a la parte"
    },
    "GInputGroupSelect": {
      "props": [
        {
          "name": "modelValue",
          "type": "String | Number",
          "default": ""
        },
        {
          "name": "name",
          "type": "String",
          "default": null
        },
        {
          "name": "partLabel",
          "type": "String",
          "default": null
        },
        {
          "name": "principal",
          "type": "Boolean",
          "default": false
        },
        {
          "name": "required",
          "type": "Boolean",
          "default": null
        },
        {
          "name": "error",
          "type": "String",
          "default": null
        },
        {
          "name": "options",
          "type": "Array",
          "default": [],
          "note": "[{ value, label, disabled? }] o grupos { label, options } (<optgroup>)"
        },
        {
          "name": "placeholder",
          "type": "String",
          "default": null,
          "note": "Primera opción vacía (disabled si la parte es obligatoria)"
        },
        {
          "name": "id",
          "type": "String",
          "default": null
        }
      ],
      "events": [
        {
          "name": "update:modelValue",
          "payload": "String",
          "trigger": "change del <select> nativo"
        }
      ],
      "readonly": "input type=text readonly con el texto de la opción + input type=hidden con el valor"
    },
    "GInputGroupText": {
      "props": [
        {
          "name": "text",
          "type": "String",
          "default": null
        },
        {
          "name": "label",
          "type": "String",
          "default": null,
          "note": "Expansión accesible: el texto visible pasa a aria-hidden"
        },
        {
          "name": "decorative",
          "type": "Boolean",
          "default": false
        },
        {
          "name": "id",
          "type": "String",
          "default": null
        }
      ],
      "slots": [
        {
          "name": "default",
          "purpose": "Texto visible"
        }
      ]
    }
  },
  "classes": [
    "g-input-group",
    "g-input-group--size-{s}",
    "g-input-group--variant-{v}",
    "g-input-group--density-{d}",
    "g-input-group--block",
    "is-disabled",
    "is-readonly",
    "is-invalid",
    "is-warning",
    "is-valid",
    "g-input-group__label",
    "g-input-group__optional",
    "g-input-group__required",
    "g-input-group__box",
    "g-input-group__part",
    "g-input-group__part--input",
    "g-input-group__part--select",
    "g-input-group__part--text",
    "g-input-group__part--chars",
    "g-input-group__part-name",
    "g-input-group__control",
    "g-input-group__select-icon",
    "g-input-group__text-label",
    "g-input-group__support",
    "g-input-group__hint",
    "g-input-group__message",
    "g-input-group__message-icon",
    "g-input-group__message-type"
  ],
  "icons": [
    "chevron-down",
    "circle-alert",
    "triangle-alert",
    "circle-check"
  ],
  "tokens": [
    "--g-space-1",
    "--g-color-border-control",
    "--g-color-border-strong",
    "--g-color-focus",
    "--g-color-neutral-soft",
    "--g-color-danger-text",
    "--g-color-warning-text",
    "--g-color-success-text"
  ],
  "states": [
    "default",
    "hover",
    "focus-visible (anillo por parte)",
    "invalid (parte)",
    "warning",
    "valid",
    "readonly",
    "disabled"
  ],
  "pending": [
    "GSelect y GNumberField como partes (Fase 2)"
  ]
}
