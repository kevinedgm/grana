{
  "name": "@grana/vue",
  "version": "0.1.0-beta.0",
  "description": "Componentes Vue 3 con tema por tokens. The only bug you'll want in your UI.",
  "keywords": [
    "vue",
    "vue3",
    "components",
    "component-library",
    "ui",
    "design-tokens",
    "theming",
    "accessibility",
    "a11y",
    "wcag"
  ],
  "homepage": "https://github.com/kevinedgm/grana/tree/main/packages/vue#readme",
  "bugs": {
    "url": "https://github.com/kevinedgm/grana/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kevinedgm/grana.git",
    "directory": "packages/vue"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/grana.js",
  "module": "./dist/grana.js",
  "types": "./dist/grana.d.ts",
  "unpkg": "./dist/grana.umd.js",
  "jsdelivr": "./dist/grana.umd.js",
  "exports": {
    ".": {
      "types": "./dist/grana.d.ts",
      "import": "./dist/grana.js",
      "default": "./dist/grana.js"
    },
    "./speech": {
      "types": "./dist/speech.d.ts",
      "import": "./dist/speech.js",
      "default": "./dist/speech.js"
    },
    "./status": {
      "types": "./dist/status.d.ts",
      "import": "./dist/status.js",
      "default": "./dist/status.js"
    },
    "./combobox": {
      "types": "./dist/combobox.d.ts",
      "import": "./dist/combobox.js",
      "default": "./dist/combobox.js"
    },
    "./file-field": {
      "types": "./dist/file-field.d.ts",
      "import": "./dist/file-field.js",
      "default": "./dist/file-field.js"
    },
    "./time-field": {
      "types": "./dist/time-field.d.ts",
      "import": "./dist/time-field.js",
      "default": "./dist/time-field.js"
    },
    "./slider": {
      "types": "./dist/slider.d.ts",
      "import": "./dist/slider.js",
      "default": "./dist/slider.js"
    },
    "./tag": {
      "types": "./dist/tag.d.ts",
      "import": "./dist/tag.js",
      "default": "./dist/tag.js"
    },
    "./load-region": {
      "types": "./dist/load-region.d.ts",
      "import": "./dist/load-region.js",
      "default": "./dist/load-region.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    },
    "./style.css": "./dist/grana.css",
    "./fonts.css": "./dist/fonts.css",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "speech": [
        "./dist/speech.d.ts"
      ],
      "status": [
        "./dist/status.d.ts"
      ],
      "combobox": [
        "./dist/combobox.d.ts"
      ],
      "file-field": [
        "./dist/file-field.d.ts"
      ],
      "time-field": [
        "./dist/time-field.d.ts"
      ],
      "slider": [
        "./dist/slider.d.ts"
      ],
      "testing": [
        "./dist/testing.d.ts"
      ],
      "tag": [
        "./dist/tag.d.ts"
      ],
      "load-region": [
        "./dist/load-region.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "THIRD-PARTY-NOTICES.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "vite build && vite build -c vite.speech.config.js && vite build -c vite.status.config.js && vite build -c vite.combobox.config.js && vite build -c vite.file-field.config.js && vite build -c vite.time-field.config.js && vite build -c vite.slider.config.js && vite build -c vite.testing.config.js && vite build -c vite.tag.config.js && vite build -c vite.load-region.config.js && node scripts/build-fonts.mjs && node scripts/build-types.mjs",
    "test": "vitest run",
    "icons": "node scripts/build-icons.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "lucide-static": "^1.49.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "lucide-static": {
      "optional": true
    }
  },
  "devDependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/test-utils": "^2.4.0",
    "jsdom": "^25.0.0",
    "lucide-static": "^1.49.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.2",
    "vitest": "^4.1.11",
    "vue": "^3.5.0",
    "vue-tsc": "^3.3.12"
  }
}
