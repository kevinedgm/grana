{
  "name": "@grana/vue",
  "version": "0.0.0",
  "description": "Componentes Vue 3 con tema por tokens. The only bug you'll want in your UI.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "THIRD-PARTY-NOTICES.md"
  ],
  "module": "./dist/grana.js",
  "unpkg": "./dist/grana.umd.js",
  "jsdelivr": "./dist/grana.umd.js",
  "exports": {
    ".": {
      "import": "./dist/grana.js"
    },
    "./speech": {
      "import": "./dist/speech.js"
    },
    "./status": {
      "import": "./dist/status.js"
    },
    "./combobox": {
      "import": "./dist/combobox.js"
    },
    "./file-field": {
      "import": "./dist/file-field.js"
    },
    "./testing": {
      "import": "./dist/testing.js"
    },
    "./style.css": "./dist/grana.css",
    "./fonts.css": "./dist/fonts.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build && vite build -c vite.speech.config.js && vite build -c vite.status.config.js && vite build -c vite.combobox.config.js && vite build -c vite.file-field.config.js && vite build -c vite.testing.config.js && node scripts/build-fonts.mjs",
    "test": "vitest run",
    "icons": "node scripts/build-icons.mjs"
  },
  "peerDependencies": {
    "lucide-static": "^1.49.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "lucide-static": {
      "optional": true
    }
  },
  "devDependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/test-utils": "^2.4.0",
    "jsdom": "^25.0.0",
    "lucide-static": "^1.49.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.11",
    "vue": "^3.5.0"
  }
}
