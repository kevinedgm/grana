{
  "compilerOptions": {
    "target": "ES2020", "module": "ES2020", "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "allowJs": true, "checkJs": true, "noEmit": true, "strict": false,
    "noImplicitAny": false, "skipLibCheck": false
  },
  "include": ["src/**/*.js", "types/**/*.d.ts", "test/types/*.ts"]
}
